# Railway Backend Environment Variables Setup
# Note: Railway automatically injects the PORT variable in production (no manual config required).
PORT=4000

# Optional Database Persistence
# If MONGODB_URI is provided, evaluations will be saved to MongoDB Atlas.
# If omitted, the server operates in resilient offline mode without crashing.
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/ats_db?retryWrites=true&w=majority
